{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure (Debug)",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S", ".",
                "-B", "build",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_PREFIX_PATH=/home/baris/Qt/6.10.1/gcc_64"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["CMake: configure (Debug)"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CMake: clean",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "build", "--target", "clean"],
            "problemMatcher": []
        },
        {
            "label": "CTest: run",
            "type": "shell",
            "command": "ctest",
            "args": ["--test-dir", "build", "--output-on-failure"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": ["CMake: build"],
            "problemMatcher": []
        },
        {
            "label": "CMake: configure (linux-debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "linux-debug"],
            "problemMatcher": []
        },
        {
            "label": "CMake: build (linux-debug)",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "linux-debug"],
            "dependsOn": ["CMake: configure (linux-debug)"],
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CTest: run (linux-debug)",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "linux-debug"],
            "dependsOn": ["CMake: build (linux-debug)"],
            "problemMatcher": []
        }
    ]
}
