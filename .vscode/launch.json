{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "macOS: Debug app --gui (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/macos-debug/app/app",
            "args": [
                "--gui"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build (macos-debug)"
        },
        {
            "name": "macOS: Debug app (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/macos-debug/app/app",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build (macos-debug)"
        },
        {
            "name": "macOS: Debug app --gui + Python strategy (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/macos-debug/app/app",
            "args": [
                "--gui"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "STONKS_DEBUGPY": "5678"
            },
            "preLaunchTask": "CMake: build (macos-debug)"
        },
        {
            "name": "macOS: Debug app + Python strategy (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/macos-debug/app/app",
            "args": [],
            "cwd": "${workspaceFolder}",
            "env": {
                "STONKS_DEBUGPY": "5678"
            },
            "preLaunchTask": "CMake: build (macos-debug)"
        },
        {
            "name": "Python: Attach to strategy (debugpy)",
            "type": "debugpy",
            "request": "attach",
            "connect": {
                "host": "127.0.0.1",
                "port": 5678
            },
            "justMyCode": false,
            "preLaunchTask": "Wait for debugpy listener"
        },
        {
            "name": "macOS: Debug core_tests (lldb)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/macos-debug/tests/core_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build (macos-debug)"
        },
        {
            "name": "Debug active CMake target",
            "type": "lldb",
            "request": "launch",
            "program": "${command:cmake.launchTargetPath}",
            "args": [],
            "cwd": "${command:cmake.launchTargetDirectory}"
        },
        {
            "name": "Linux: Debug app (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-debug/app/app",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (linux-debug)",
            "visualizerFile": "/Users/macmini-1/.vscode-server/data/User/workspaceStorage/f916120416e956326d3fb512734993e2/tonka3000.qtvsctools/qt.natvis.xml"
        },
        {
            "name": "Linux: Debug app --gui (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-debug/app/app",
            "args": [
                "--gui"
            ],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (linux-debug)",
            "visualizerFile": "/Users/macmini-1/.vscode-server/data/User/workspaceStorage/f916120416e956326d3fb512734993e2/tonka3000.qtvsctools/qt.natvis.xml"
        },
        {
            "name": "Linux: Debug core_tests (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/linux-debug/tests/core_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: build (linux-debug)",
            "visualizerFile": "/Users/macmini-1/.vscode-server/data/User/workspaceStorage/f916120416e956326d3fb512734993e2/tonka3000.qtvsctools/qt.natvis.xml"
        }
    ],
    "compounds": [
        {
            // The app blocks at startup until debugpy attaches, so the ordering
            // here is safe. If the attach half errors out because the preLaunch
            // build was slow, just start it again on its own.
            "name": "macOS: Debug app + Python (lldb + debugpy)",
            "configurations": [
                "macOS: Debug app + Python strategy (lldb)",
                "Python: Attach to strategy (debugpy)"
            ],
            "stopAll": true
        },
        {
            "name": "macOS: Debug app --gui + Python (lldb + debugpy)",
            "configurations": [
                "macOS: Debug app --gui + Python strategy (lldb)",
                "Python: Attach to strategy (debugpy)"
            ],
            "stopAll": true
        }
    ]
}
